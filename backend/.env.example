# CryptoChap Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cryptochap
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_MAX_CONNECTIONS=20

# ==========================================
# WHATSAPP/META CONFIGURATION
# ==========================================
# Get these from https://developers.facebook.com/apps/
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_WHATSAPP_TOKEN=your_whatsapp_token_here
META_API_VERSION=v18.0
META_APP_SECRET=your_app_secret_here
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# ==========================================
# BLOCKCHAIN CONFIGURATION
# ==========================================
NETWORK=base
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_SECRET=your_super_secure_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# REDIS CONFIGURATION (Optional)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# RATE LIMITING CONFIGURATION
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
STRICT_RATE_LIMIT_WINDOW_MS=60000
STRICT_RATE_LIMIT_MAX_REQUESTS=10

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIRECTORY=logs

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================

# 1. DATABASE SETUP:
#   - Install PostgreSQL
#   - Create database: createdb cryptochap
#   - Run the schema.sql file to create tables

# 2. WHATSAPP SETUP:
#   - Go to https://developers.facebook.com/apps/
#   - Create a new app or use existing Business app
#   - Add WhatsApp product
#   - Get your Phone Number ID and Token
#   - Set up webhooks pointing to your backend URL

# 3. BLOCKCHAIN SETUP:
#   - For Base mainnet: Use the default RPC URL
#   - For testing: Use Base Sepolia
#   - Get an Infura/Alchemy API key for Ethereum if needed

# 4. SECURITY:
#   - Generate a strong JWT_SECRET (at least 32 characters)
#   - Use strong passwords for database
#   - Keep META_APP_SECRET and tokens secure
#   - Never commit real values to version control

# 5. PRODUCTION DEPLOYMENT:
#   - Set NODE_ENV=production
#   - Use production database credentials
#   - Set up proper SSL certificates
#   - Configure firewall rules
#   - Set up monitoring and logging

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Meta WhatsApp Business API Configuration
META_WHATSAPP_TOKEN=EAAG... # Your WhatsApp Business API token
META_VERIFY_TOKEN=your_webhook_verify_token # Custom verification token for webhooks
META_PHONE_NUMBER_ID=1xxxxxxxxxxxxxxx # Your WhatsApp Business phone number ID
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # App Secret for webhook verification
META_API_VERSION=v18.0 # WhatsApp API version

# Database Configuration (if using PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/cryptochap

# Redis Configuration (if using Redis for caching)
REDIS_URL=redis://localhost:6379

# JWT Configuration (if using JWT for authentication)
JWT_SECRET=your_jwt_secret_key_here

# Other optional configurations
WEBHOOK_VERIFY_TIMEOUT=300000 # 5 minutes in milliseconds