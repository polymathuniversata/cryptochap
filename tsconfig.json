{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": [
    "tests/**/*",
    "backend/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist"
  ],
  "references": [
    {
      "path": "./backend"
    },
    {
      "path": "./frontend"
    },
    {
      "path": "./tests"
    }
  ]
}